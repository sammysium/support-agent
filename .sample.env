# Copy to .env and fill in. Values here are the local docker setup and fs/mock_apis.

# Chats (Postgres)
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/sherrif

# Couchbase SDK
CB_URL=couchbase://localhost
CB_USERNAME=
CB_PASSWORD=
CB_READS_BUCKET_NAME=offline-reads
# Couchbase management REST (nodes, rebalance, quotas)
CB_MANAGEMENT_URL=http://localhost:8091

# Sync Gateway: the URL devices sync through
SG_PUBLIC_URL=http://localhost:4984
# Sync Gateway admin API. Credentials are a Couchbase Server user with a Sync Gateway role; empty where admin auth is off
SG_ADMIN_URL=http://localhost:4985
SG_READS_DB=offline-reads
SG_ADMIN_USERNAME=
SG_ADMIN_PASSWORD=

# Fineract API root. Leave FINERACT_TOKEN_URL empty for mock_apis (no login); set it for Keycloak
FINERACT_BASE_URL=http://localhost:8443/fineract-provider/api/v1
FINERACT_TENANT_ID=default
FINERACT_TOKEN_URL=
FINERACT_CLIENT_ID=fineract
FINERACT_USERNAME=
FINERACT_PASSWORD=

# Jira bugs
JIRA_URL=https://<your-site>.atlassian.net
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJECT=

# Jira service desk requests
JIRA_SERVICE_DESK_URL=https://<your-site>.atlassian.net
JIRA_SERVICE_DESK_ID=
JIRA_SERVICE_REQUEST_TYPE_ID=
